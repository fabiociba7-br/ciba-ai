{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garcia.invalid/schemas/app-message-v1.schema.json",
  "title": "Garcia App Message v1",
  "description": "Request body accepted by POST /v1/apps/messages. Payload is data only and must never be executed as code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["destination_app_id", "client_message_id", "task_id", "scope", "payload"],
  "properties": {
    "destination_app_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "client_message_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scope": { "type": "string", "enum": ["task", "context"] },
    "payload": {
      "type": "object",
      "description": "Application-defined JSON data. Include type and version fields and validate them at the receiver."
    },
    "ttl_hours": { "type": "integer", "minimum": 1, "maximum": 72, "default": 24 }
  }
}
